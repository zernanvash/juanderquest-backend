# JuanderQuest "real UX" profile — copy to `.env.prod` and run with JDQ_ENV=prod.
# The database stays clean: no development seeds, no in-memory fallback. It runs
# in development mode with local conveniences (wildcard CORS, local wallet
# login) so the localhost web app can talk to it; harden NODE_ENV/CORS here if
# you point this profile at a real deployed environment.
NODE_ENV=development
PORT=4100
HOST=127.0.0.1
DATABASE_URL=postgres://postgres:postgres@localhost:5432/juanderquest_prod
# Replace with a unique secret; never reuse the development secret.
JWT_SECRET=replace_with_a_unique_64_char_secret_before_starting
CORS_ORIGIN=*
WALLET_AUTH_MODE=local
ALLOW_INSECURE_LOCAL_WALLET_AUTH=true
ALLOW_DEMO_LOGIN=false
GUEST_LOGIN_ENABLED=true
ALLOW_IN_MEMORY_FALLBACK=false
SEED_DEVELOPMENT_DATA=false
ALLOW_LEGACY_MARKER_PROOF=false
MARKETPLACE_ENABLED=false
