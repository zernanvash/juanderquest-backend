PORT=4100
HOST=127.0.0.1
NODE_ENV=development
DATABASE_URL=postgres://postgres:postgres@localhost:5432/juanderquest
# Explicit local-only escape hatch when PostgreSQL is intentionally unavailable.
ALLOW_IN_MEMORY_FALLBACK=true
# Loads prototype fixtures and seeds/development.sql; forbidden in production.
SEED_DEVELOPMENT_DATA=true
JWT_SECRET=juanderquest_prototype_secret_key_2026_super_secure
# Development only: production must explicitly list HTTPS origins (no wildcard).
CORS_ORIGIN=*
# Production example: CORS_ORIGIN=https://juanderquest.app,https://www.juanderquest.app,https://admin.juanderquest.app
# local = explicit development bypass; signature = cryptographic wallet proof
WALLET_AUTH_MODE=signature
# Independent guest user accounts; production defaults off unless explicitly enabled.
GUEST_LOGIN_ENABLED=true
# Required in production only when deliberately testing the insecure local bypass.
ALLOW_INSECURE_LOCAL_WALLET_AUTH=false
SPOT_PHOTO_STORAGE=local
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=spot-photos
LOCAL_UPLOAD_DIR=uploads/spot-photos
VALHALLA_URL=http://127.0.0.1:8002

# Experimental PostgreSQL ballot write batching. Keep off outside isolated
# capacity tests until the ten-minute and staging release gates pass.
JUANCHOICE_BATCH_WRITES_ENABLED=false
