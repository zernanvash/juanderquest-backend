# JuanderQuest development profile — copy to `.env.dev` and run with JDQ_ENV=dev.
# Seed fixtures load on every boot; this database is disposable dummy data.
NODE_ENV=development
PORT=4100
HOST=127.0.0.1
DATABASE_URL=postgres://postgres:postgres@localhost:5432/juanderquest_dev
JWT_SECRET=dev_only_jwt_secret_do_not_use_in_production
CORS_ORIGIN=*
WALLET_AUTH_MODE=local
ALLOW_INSECURE_LOCAL_WALLET_AUTH=true
ALLOW_DEMO_LOGIN=true
GUEST_LOGIN_ENABLED=true
ALLOW_IN_MEMORY_FALLBACK=true
SEED_DEVELOPMENT_DATA=true
MARKETPLACE_ENABLED=true
